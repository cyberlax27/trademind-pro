# Copy to .env for local dev only. In production (Render), set these as
# actual Environment Variables in the Render dashboard — never commit .env.

PORT=5000
JWT_SECRET=replace-with-a-long-random-string
APP_BASE_URL=http://localhost:5000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# PayPal REST API (Orders v2)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Must be the literal string "live" to hit the real PayPal API.
# Any other value (including unset) falls back to sandbox.
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# PayMongo is disabled in the public interface until explicitly re-enabled.
PAYMONGO_ENABLED=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_MODE=test
